{
  "name": "dsh-prompt-brief",
  "version": "0.1.1",
  "description": "把一句口语需求写成结构化产品简报（定位 / 核心功能 / 视觉参考 / 设计规范），输入框一键触发，左右对照后接受、重新生成或取消",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-client-plugin",
    "prompt",
    "prompt-engineering",
    "prompt-optimizer",
    "structured-prompt"
  ],
  "author": "ly14278",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ly14278/dsh-prompt-brief.git"
  },
  "homepage": "https://github.com/ly14278/dsh-prompt-brief#readme",
  "bugs": {
    "url": "https://github.com/ly14278/dsh-prompt-brief/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
